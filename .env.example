# Server-only. Never prefix secrets with VITE_.
DATABASE_URL=
# Generate with: openssl rand -hex 32
OWNER_ACCESS_TOKEN=
# Keep this stable. Changing it changes the owner of records being accessed.
OWNER_ID=00000000-0000-4000-8000-000000000001
OWNER_TIME_ZONE=Asia/Kolkata
PORT=3001

# Phase 1 accounts (server-only; owner access works without these).
# Generate a NEW secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Local: http://127.0.0.1:5173 | Netlify: https://momentin.netlify.app
BETTER_AUTH_URL=http://127.0.0.1:5173
# Comma-separated emails allowed to create/use accounts. Empty = nobody.
AUTH_ALLOWED_EMAILS=
# Your SMTP provider credentials for verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google OAuth web client; enables the Google button when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Brevo HTTPS transport; takes precedence over SMTP when set.
# Use an API key, not an SMTP key. SMTP_FROM is used for either transport.
BREVO_API_KEY=

# Public registration is the default; invite mode is optional.
AUTH_REGISTRATION_MODE=public
ADMIN_EMAILS=nirjadesai98@gmail.com,littlesparkstudio.apps@gmail.com
